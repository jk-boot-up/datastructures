# Lombok reads this file (and every lombok.config in parent folders) to decide
# how to generate code. Two settings, both worth knowing about:

# Stop Lombok from walking further up the directory tree looking for more config
# files. This makes the project genuinely stand-alone: nothing outside this
# folder can change how it compiles.
config.stopBubbling = true

# Mark every generated method with @lombok.Generated. Coverage tools (JaCoCo)
# and static analysers then know to skip code you did not write, so your
# coverage numbers stay honest.
lombok.addLombokGeneratedAnnotation = true
